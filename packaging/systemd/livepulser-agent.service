[Unit]
Description=LivePulser resource agent
Documentation=https://github.com/livepulser/livepulser-agent
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=livepulser-agent
Group=livepulser-agent
ExecStart=/usr/local/bin/livepulser-agent --config /etc/livepulser-agent/agent.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30
# 77: API key rejected at startup, 78: configuration error. Restarting cannot fix either.
RestartPreventExitStatus=77 78
StateDirectory=livepulser-agent
StateDirectoryMode=0700
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
